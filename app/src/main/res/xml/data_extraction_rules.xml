<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude sensitive user data from cloud backup -->
        <exclude domain="database" path="verse_database" />
        <exclude domain="sharedpref" path="faithflow_prefs.xml" />
        <exclude domain="sharedpref" path="theme_order_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude sensitive user data from device transfer -->
        <exclude domain="database" path="verse_database" />
        <exclude domain="sharedpref" path="faithflow_prefs.xml" />
        <exclude domain="sharedpref" path="theme_order_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
